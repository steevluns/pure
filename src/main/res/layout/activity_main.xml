<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- الشريط العلوي Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#121212"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="DownLS10"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddUrl"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnBrowser"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_circle_gray"
                android:text="" />

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/downloadActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="#101010">

        <!-- صف الأزرار: حذف المكتملة | حذف الكل (متساويين) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnDeleteCompleted"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="حذف المكتملة"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDeleteAllDownloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="حذف الكل"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- عداد التنزيلات كنص صغير أسفل الأزرار -->
        <TextView
            android:id="@+id/tvDownloadCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="عدد الملفات: 0"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:paddingTop="2dp" />
    </LinearLayout>

    <!-- قائمة التنزيلات: تمت إزالة زر "عرض ملفات التنزيلات" من الواجهة -->
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/downloadActions"
        android:divider="#222222"
        android:dividerHeight="1dp" />

    <!-- حاوية ملفات التنزيلات القديمة مخفية وغير معروضة في الواجهة -->
    <LinearLayout
        android:id="@+id/downloadFilesContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/downloadActions"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#000000"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvDownloadFilesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ملفات التنزيلات"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/downloadFilesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#222222"
            android:dividerHeight="1dp"
            android:clipToPadding="false" />
    </LinearLayout>

</RelativeLayout>
